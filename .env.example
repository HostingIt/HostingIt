# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Free-tier URLs: https://{prefix}-{slug}.{BASE_DOMAIN} e.g. fhusr-my-api.hostingit.online
# First-level subdomains work with Cloudflare orange cloud + free Universal SSL
NEXT_PUBLIC_BASE_DOMAIN=hostingit.online
NEXT_PUBLIC_FREE_SUBDOMAIN_PREFIX=fhusr

# Auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database
DATABASE_URL=postgresql://hostingit:hostingit@localhost:5432/hostingit

# Redis (optional v1)
REDIS_URL=redis://localhost:6379

# Deploy platform (Instance 1 — internal)
DOKPLOY_API_URL=https://platform.yourdomain.com
DOKPLOY_API_KEY=
# HostingIt GitHub App — users install this to grant repo access (Railway/Vercel model)
# Create at https://github.com/settings/apps/new
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key (paste with \n) or base64-encoded PEM
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# GitHub App Setup URL:  {NEXT_PUBLIC_APP_URL}/api/github/app/callback
# GitHub App Webhook URL: {NEXT_PUBLIC_APP_URL}/api/github/app/webhook
# Permissions: Contents Read, Metadata Read; Subscribe to: Push, Installation

# Admin bootstrap
ADMIN_EMAIL=you@example.com

# Payments (display only)
PAYMENT_UPI_ID=
PAYMENT_PAYPAL=
PAYMENT_BANK_DETAILS=
