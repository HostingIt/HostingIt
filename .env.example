# ─── App (public — also pass as Docker build-args) ───
NEXT_PUBLIC_APP_URL=https://hostingit.online
# Free-tier URLs: https://{prefix}-{slug}.{BASE_DOMAIN}
NEXT_PUBLIC_BASE_DOMAIN=hostingit.online
NEXT_PUBLIC_FREE_SUBDOMAIN_PREFIX=fhusr

# ─── Auth.js ───
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Canonical URL for Auth.js (usually same as NEXT_PUBLIC_APP_URL)
AUTH_URL=https://hostingit.online
AUTH_TRUST_HOST=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Database (HostingIt panel DB — separate from user apps) ───
DATABASE_URL=postgresql://hostingit:CHANGE_ME@postgres:5432/hostingit

# Redis (optional)
REDIS_URL=redis://localhost:6379

# ─── Deploy platform API (Dokploy — server-side only) ───
DOKPLOY_API_URL=https://your-dokploy-host
DOKPLOY_API_KEY=

# ─── HostingIt GitHub App (users install this for repo access) ───
# Create at https://github.com/settings/apps/new
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key (paste with \n) or base64-encoded PEM
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Setup URL:   {NEXT_PUBLIC_APP_URL}/api/github/app/callback
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/github/app/webhook
# Permissions: Contents Read, Metadata Read
# Events: Push, Installation, Installation repositories

# ─── Admin bootstrap ───
ADMIN_EMAIL=you@example.com

# ─── Payments (display only) ───
PAYMENT_UPI_ID=
PAYMENT_PAYPAL=
PAYMENT_BANK_DETAILS=
